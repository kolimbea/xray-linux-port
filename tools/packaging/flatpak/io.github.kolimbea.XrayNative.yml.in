# Flatpak of the native build: the self-contained release package (tools/packaging/make_packages.sh)
# on the freedesktop runtime. Generated by tools/packaging/store_files.sh.
# The GAMMA installation is read only (home, /mnt, /media, /run/media); the launcher's data (overlay,
# saves, downloaded updates) lives in the sandbox's ~/.var/app/io.github.kolimbea.XrayNative.
app-id: io.github.kolimbea.XrayNative
runtime: org.freedesktop.Platform
runtime-version: '25.08'
sdk: org.freedesktop.Sdk
command: xray-launcher
finish-args:
  - --share=network            # launcher updates from GitHub releases
  - --share=ipc
  - --socket=wayland
  - --socket=fallback-x11
  - --socket=pulseaudio
  - --device=dri
  - --filesystem=home:ro
  - --filesystem=/mnt:ro
  - --filesystem=/media:ro
  - --filesystem=/run/media:ro
modules:
  - name: xray-native
    buildsystem: simple
    build-commands:
      - mkdir -p /app/opt /app/bin
      - cp -a . /app/opt/xray-native
      - ln -s /app/opt/xray-native/bin/xray-launcher /app/bin/xray-launcher
      - install -Dm644 share/applications/xray-native.desktop /app/share/applications/io.github.kolimbea.XrayNative.desktop
      - sed -i 's/^Icon=.*/Icon=io.github.kolimbea.XrayNative/' /app/share/applications/io.github.kolimbea.XrayNative.desktop
      - install -Dm644 share/icons/hicolor/scalable/apps/xray-native.svg /app/share/icons/hicolor/scalable/apps/io.github.kolimbea.XrayNative.svg
    sources:
      - type: archive
        @SOURCE@
        sha256: @SHA256@
