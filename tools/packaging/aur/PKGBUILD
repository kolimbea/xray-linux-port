pkgname=xray-native-bin
_tag=v0.1.0-alpha
pkgver=0.1.0alpha
pkgrel=1
pkgdesc="Native Linux build of the X-Ray Monolith engine (S.T.A.L.K.E.R. Anomaly/GAMMA) with a Vulkan renderer and launcher"
arch=('x86_64')
url="https://github.com/kolimbea/xray-linux-port"
license=('custom')
depends=('glibc>=2.41' 'gcc-libs' 'vulkan-icd-loader' 'libx11' 'libxext' 'libxcursor' 'libxfixes' 'libxi'
         'libxrandr' 'libxrender' 'libxss' 'libxcb' 'libxkbcommon' 'wayland' 'libdecor' 'mesa' 'libpipewire'
         'libpulse' 'alsa-lib')
optdepends=('vulkan-driver: Vulkan 1.3 GPU driver'
            'curl: launcher updates'
            'fontconfig: launcher font lookup')
provides=('xray-native')
conflicts=('xray-native')
options=('!strip' '!debug')
source=("https://github.com/kolimbea/xray-linux-port/releases/download/${_tag}/xray-native-${_tag}-linux-x86_64.tar.gz")
sha256sums=('2a157dac038eb5bf950d7f4829e68a361ef59192c63859e99d67c60ae66ac28e')

package() {
    install -d "$pkgdir/opt" "$pkgdir/usr/bin"
    cp -a "$srcdir/xray-native" "$pkgdir/opt/xray-native"
    ln -s /opt/xray-native/bin/xray-launcher "$pkgdir/usr/bin/xray-launcher"
    install -Dm644 "$srcdir/xray-native/share/applications/xray-native.desktop" \
        "$pkgdir/usr/share/applications/xray-native.desktop"
    install -Dm644 "$srcdir/xray-native/share/icons/hicolor/scalable/apps/xray-native.svg" \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/xray-native.svg"
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    cp -a "$srcdir/xray-native/share/licenses/." "$pkgdir/usr/share/licenses/$pkgname/"
}
